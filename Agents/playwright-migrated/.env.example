# Copy this file to .env (gitignored — never commit a real .env) and fill
# in real values for your environment. playwright.config.ts loads this via
# `dotenv`.

# Base URL of the application under test.
BASE_URL=http://localhost:3000

# If setup/auth.setup.ts is enabled (see the "setup" project in
# playwright.config.ts), the test credentials it uses should come from
# env vars like these, never hardcoded in the setup file itself:
# TEST_USERNAME=
# TEST_PASSWORD=
